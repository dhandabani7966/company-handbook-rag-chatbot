# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=production
DEBUG=false
ENABLE_DOCS=false

# Security & JWT Authentication (REQUIRED in production, minimum 32 characters)
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_cryptographically_secure_32_character_hex_key

# Allowed CORS Origins (comma-separated list of trusted origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage Paths
DOCUMENTS_DIR=data/documents
CHROMA_DB_DIR=data/chroma_db
COLLECTION_NAME=company_handbook

# Models
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
LLM_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct

# RAG Hyperparameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
